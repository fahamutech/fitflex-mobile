# FitFlex Mobile
# Flutter reads API_BASE through --dart-define:
# flutter run --dart-define=API_BASE=http://localhost:3000
# When API_BASE is unset, builds use the live server
# https://fitflex-faas.bfast.smartstock.co.tz. Keep localhost here for local dev.
API_BASE=http://localhost:3000

# Firebase config is provided by platform files, not this env file:
# Android: android/app/google-services.json
# iOS: ios/Runner/GoogleService-Info.plist
FIREBASE_PROJECT_ID=fitflex-af-pilot

# If running Flutter web later, mirror the portal Firebase web config:
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
